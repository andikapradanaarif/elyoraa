# GitHub App
GITHUB_APP_ID=12345
GITHUB_APP_PRIVATE_KEY=/run/secrets/github-app-private-key
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Devin
DEVIN_BIN=/usr/local/bin/devin
DEVIN_CONFIG_PATH=/app/devin-config.json
# Optional: enables mem0 memory
# MEM0_API_KEY=...

# Paths
WORKSPACE_BASE=/var/lib/elyoraa/workspace
ELYORAA_TOKEN_DIR=/tmp/elyoraa

# Limits
MAX_CONCURRENT_REVIEWS=2
MAX_PATCH_BYTES=100000
MAX_CHANGED_FILES=50
WORKTREE_TTL_HOURS=24
WORKSPACE_DISK_BUDGET_GB=40

# Queue
QUEUE_BACKEND=memory
QUEUE_FILE_PATH=/var/lib/elyoraa/queue.db

# Server
PORT=8080
LOG_LEVEL=info

# For docker-compose bind mounts
DEVIN_BIN_HOST_PATH=/usr/local/bin/devin
GITHUB_APP_PRIVATE_KEY_SECRET=./secrets/github-app-private-key.pem
