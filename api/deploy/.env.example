# GitHub App
GITHUB_APP_ID=12345
GITHUB_APP_PRIVATE_KEY=/run/secrets/github-app-private-key
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Database (optional)
# DATABASE_URL=postgres://user:pass@postgres:5432/elyoraa

# Devin
DEVIN_BIN=/usr/local/bin/devin
DEVIN_CONFIG_DIR=/var/lib/elyoraa/devin-config
DEVIN_MODEL=swe-1.7
# Optional: enables mem0 memory
# MEM0_API_KEY=...

# Paths
# Repos must be pre-cloned as bare clones at: WORKSPACE_HOST_PATH/{owner}/{repo}.git
# e.g. git clone --bare https://github.com/owner/repo.git ~/app/elyoraa/repo/owner/repo.git
#       git -C ~/app/elyoraa/repo/owner/repo.git config --local --add \
#         remote.origin.fetch "+refs/pull/*/head:refs/remotes/origin/pr/*"
WORKSPACE_HOST_PATH=~/app/elyoraa/repo
WORKSPACE_BASE=/var/lib/elyoraa/workspace
ELYORAA_TOKEN_DIR=/var/lib/elyoraa/tokens

# Limits
MAX_CONCURRENT_REVIEWS=2
MAX_PATCH_BYTES=100000
MAX_CHANGED_FILES=50
WORKTREE_TTL_HOURS=24
WORKSPACE_DISK_BUDGET_GB=40

# Bot
BOT_HANDLE=elyoraa

# Queue
QUEUE_BACKEND=memory
QUEUE_FILE_PATH=/var/lib/elyoraa/queue.db

# Server
PORT=8080
LOG_LEVEL=info

# For docker-compose bind mounts
DEVIN_BIN_HOST_PATH=/usr/local/bin/devin
GITHUB_APP_PRIVATE_KEY_SECRET=./secrets/github-app-private-key.pem
