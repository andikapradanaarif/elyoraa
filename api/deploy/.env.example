# GitHub App
GITHUB_APP_ID=12345
GITHUB_APP_PRIVATE_KEY=/run/secrets/github-app-private-key
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Database (optional)
# DATABASE_URL=postgres://user:pass@postgres:5432/elyoraa

# Devin
DEVIN_BIN=/usr/local/bin/devin
DEVIN_CONFIG_DIR=/var/lib/elyoraa/devin-config
DEVIN_MODEL=swe-2-high
# Optional: enables mem0 memory
# MEM0_API_KEY=...

# Paths
# Repos are cloned on demand as bare clones at: WORKSPACE_HOST_PATH/{owner}/{repo}.git
# (first webhook for a repo triggers the clone; no manual pre-clone needed)
# Use absolute paths (no ~) — especially when running docker compose with sudo.
WORKSPACE_HOST_PATH=/home/user/app/elyoraa/repo
WORKSPACE_BASE=/var/lib/elyoraa/workspace
ELYORAA_TOKEN_DIR=/var/lib/elyoraa/tokens
# GIT_ASKPASS_PATH is the credential helper used for server-side fetches and
# the agent's repo-sync — it only answers credential prompts for the
# GIT_BASE_URL host, so installation tokens can't leak to another remote.
# GIT_ASKPASS_PATH=/app/git-askpass.sh

# Limits
MAX_CONCURRENT_REVIEWS=2
MAX_PATCH_BYTES=100000
MAX_CHANGED_FILES=50
# PR size gate: when estimated review time exceeds the budget, the bot posts
# a PR-split proposal instead of a full review. Estimate = changed lines
# / lines-per-minute rate. The rate self-calibrates from observed review
# durations (median of recent completed jobs); PR_LINES_PER_MINUTE is the
# initial value / fallback until enough samples exist.
PR_SIZE_GATE=true
PR_REVIEW_BUDGET_MINUTES=15
PR_LINES_PER_MINUTE=100
WORKTREE_TTL_HOURS=24
WORKSPACE_DISK_BUDGET_GB=40

# Bot
BOT_HANDLE=elyoraa

# Timeouts. REVIEW_TIMEOUT bounds the whole job — review attempt(s),
# retry backoffs, and the reconcile second pass — so keep it comfortably
# >= PR_REVIEW_BUDGET_MINUTES or budget-sized PRs are killed mid-review.
# COMMENT_TIMEOUT covers posting reviews/comments to GitHub; large reviews
# need more than a few seconds.
REVIEW_TIMEOUT=30m
COMMENT_TIMEOUT=60s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
# Per-attempt timeout for each devin invocation; 0 = use REVIEW_TIMEOUT.
# Set below REVIEW_TIMEOUT to make timeouts retriable.
# DEVIN_ATTEMPT_TIMEOUT=0

# Devin retry policy: retries for transient failures after the first attempt.
# Attempts = 1 + DEVIN_MAX_RETRIES; backoffs are comma-separated durations.
DEVIN_MAX_RETRIES=3
DEVIN_RETRY_BACKOFFS=30s,2m,5m
# Pre-flight check: run `devin models list` before each attempt and require
# the configured model to be present. Disable if your devin build lacks it.
DEVIN_PREFLIGHT_CHECK=true

# Agent isolation: --sandbox runs Devin under OS-level isolation
# (bubblewrap+socat, both in the image) so Read(...) deny rules hide
# credentials — /run/secrets, the token dir, devin-config, ~/.config/devin —
# even from shell commands. Strongly recommended: the agent reads untrusted
# PR code and comment text. Devin fails closed if the sandbox can't start,
# so set false only for dev environments without bwrap.
DEVIN_SANDBOX=true

# Mention router: how @-mentions are interpreted.
#   keywords — deterministic keyword routing (default, no extra cost)
#   agent    — a Devin run reads the full discussion and declares bounded
#              actions in a fenced ```elyoraa-actions block (request_review /
#              request_split / request_issue_analysis / create_issues / reply).
#              Slash commands (/review /split /accept) bypass the agent.
MENTION_ROUTER=keywords
# RESPOND_MODEL (default DEVIN_MODEL), RESPOND_TIMEOUT (default REVIEW_TIMEOUT),
# RESPOND_MAX_ACTIONS (default 4, must be >= 1) tune the agent router's runs.
# RESPOND_MODEL=swe-2-high
# RESPOND_TIMEOUT=5m

# Size gate mode: what happens when a PR exceeds the review-time budget.
#   deterministic — always enqueue a split proposal (default)
#   agent         — 1x–3x budget: a cheap triage run judges complexity from
#                   the file manifest + worktree, then reviews or splits
#                   inline; >3x or truncated still splits directly
SIZE_GATE_MODE=deterministic
# GATE_MODEL (default RESPOND_MODEL, then DEVIN_MODEL) and GATE_TIMEOUT
# (default 5m; triage-pass budget only — the gate job itself gets
# REVIEW_TIMEOUT) tune the triage runs.
# GATE_MODEL=swe-2-high
# GATE_TIMEOUT=5m

# Queue. file (BoltDB) survives restarts: queued jobs re-run on boot, and
# stuck "processing" records are reconciled to failed at startup. memory is
# fine for dev only — a restart loses queued work.
# postgres enables MULTI-REPLICA operation: queue, job records and dedup
# claims live in Postgres, so N replicas share work safely (requires
# DATABASE_URL). Single replica works too — it's just as durable as file.
QUEUE_BACKEND=file
QUEUE_FILE_PATH=/var/lib/elyoraa/queue/queue.db
# How long a Postgres queue claim may run before another replica reclaims it
# (0 = REVIEW_TIMEOUT + 5m). Must exceed the longest job runtime.
# QUEUE_JOB_LEASE=25m
# How long workers may finish in-flight jobs on shutdown before they're
# cancelled; 0 = REVIEW_TIMEOUT.
# SHUTDOWN_DRAIN_TIMEOUT=15m

# Server
PORT=8080
LOG_LEVEL=info
# Admin endpoints (GET /jobs*, POST /jobs/retry, METRICS_PATH) share this
# public port — they require "Authorization: Bearer $ADMIN_TOKEN" and
# return 404 when unset (closed by default).
# ADMIN_TOKEN=generate-a-long-random-string
# Inbound webhook payload cap (bytes).
# WEBHOOK_MAX_BYTES=5242880
# Global kill switch: drop all webhook processing, stay healthy for probes.
# ELYORAA_PAUSED=false
# Mention cost controls: max mention-triggered jobs per author per repo per
# window (0 disables), and a hard cap on jobs started per repo per UTC day
# (0 disables).
# MENTION_RATE_LIMIT=20
# MENTION_RATE_WINDOW=1h
# DAILY_JOB_CAP_PER_REPO=50
# Webhook audit log retention (days); <=0 disables the daily cleanup. The
# table stores full payloads, so keep this bounded.
# AUDIT_RETENTION_DAYS=30

# Per-PR opt-out label: suppresses automated jobs while present on the PR.
# Explicit @mentions still run. Per-repo override via .elyoraa.yml skip_label.
# Empty disables the feature.
# PR_SKIP_LABEL=elyoraa:skip

# Clone URL prefix for clone-on-demand (repos are cloned as needed — no
# manual pre-clone required). Override for GitHub Enterprise.
# GIT_BASE_URL=https://github.com

# Per-repo overrides via .elyoraa.yml on the repo's default branch:
#   enabled, budget_minutes, lines_per_minute, ignored_paths,
#   mention_router, size_gate_mode, skip_label
# (always read from the default branch — a PR cannot change its own policy)

# For docker-compose bind mounts — use absolute paths (no ~)
DEVIN_CREDS_HOST_PATH=/home/user/.config/devin
DEVIN_DATA_HOST_PATH=/home/user/.local/share/devin
GITHUB_APP_PRIVATE_KEY_SECRET=./secrets/github-app-private-key.pem
