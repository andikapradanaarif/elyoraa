# GitHub App
GITHUB_APP_ID=12345
GITHUB_APP_PRIVATE_KEY=/path/to/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Database (optional)
# DATABASE_URL=postgres://user:pass@localhost:5432/elyoraa

# Devin
DEVIN_BIN=devin
DEVIN_CONFIG_PATH=/app/devin-config.json
DEVIN_MODEL=swe-1.7
# Optional: enables mem0 memory
# MEM0_API_KEY=...

# Paths (adjust for local dev)
WORKSPACE_BASE=/tmp/elyoraa/workspace
ELYORAA_TOKEN_DIR=/tmp/elyoraa

# Limits
MAX_CONCURRENT_REVIEWS=2
MAX_PATCH_BYTES=100000
MAX_CHANGED_FILES=50
WORKTREE_TTL_HOURS=24
WORKSPACE_DISK_BUDGET_GB=40

# Queue: memory or file (BoltDB)
QUEUE_BACKEND=memory
QUEUE_FILE_PATH=/tmp/elyoraa/queue.db

# Bot
BOT_HANDLE=elyoraa

# Server
PORT=8080
LOG_LEVEL=info
