# GitHub App
GITHUB_APP_ID=12345
GITHUB_APP_PRIVATE_KEY=/path/to/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Database (optional)
# DATABASE_URL=postgres://user:pass@localhost:5432/elyoraa

# Devin
DEVIN_BIN=devin
DEVIN_CONFIG_DIR=/tmp/elyoraa/devin-config
DEVIN_MODEL=swe-1.7
# Optional: enables mem0 memory
# MEM0_API_KEY=...
# Prompts directory (defaults to /app/prompts in Docker)
# PROMPTS_DIR=/app/prompts

# Paths (adjust for local dev)
# Repos must be pre-cloned as bare clones at: WORKSPACE_BASE/{owner}/{repo}.git
# e.g. git clone --bare https://github.com/owner/repo.git /tmp/elyoraa/workspace/owner/repo.git
#       git -C /tmp/elyoraa/workspace/owner/repo.git config --local --add \
#         remote.origin.fetch "+refs/pull/*/head:refs/remotes/origin/pr/*"
WORKSPACE_BASE=/tmp/elyoraa/workspace
ELYORAA_TOKEN_DIR=/tmp/elyoraa/tokens

# Limits
MAX_CONCURRENT_REVIEWS=2
MAX_PATCH_BYTES=100000
MAX_CHANGED_FILES=50
WORKTREE_TTL_HOURS=24
WORKSPACE_DISK_BUDGET_GB=40

# Queue: memory or file (BoltDB)
QUEUE_BACKEND=memory
QUEUE_FILE_PATH=/tmp/elyoraa/queue.db

# Bot
BOT_HANDLE=elyoraa

# Timeouts
REVIEW_TIMEOUT=10m
COMMENT_TIMEOUT=10s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s

# Server
PORT=8083
LOG_LEVEL=info
