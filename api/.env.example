# GitHub App
GITHUB_APP_ID=12345
GITHUB_APP_PRIVATE_KEY=/path/to/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Database (optional)
# DATABASE_URL=postgres://user:pass@localhost:5432/elyoraa

# Devin
DEVIN_BIN=devin
DEVIN_CONFIG_DIR=/tmp/elyoraa/devin-config
DEVIN_MODEL=swe-2-high
# Optional: enables mem0 memory
# MEM0_API_KEY=...
# Prompts directory (defaults to /app/prompts in Docker)
# PROMPTS_DIR=/app/prompts

# Paths (adjust for local dev)
# WORKSPACE_BASE is the repo registry — only pre-cloned repos are served;
# webhooks for anything else are dropped silently. Register a repo with a
# plain bare clone (the required fetch refspecs self-repair on first job):
#   git clone --bare https://github.com/owner/repo.git /tmp/elyoraa/workspace/owner/repo.git
WORKSPACE_BASE=/tmp/elyoraa/workspace
ELYORAA_TOKEN_DIR=/tmp/elyoraa/tokens

# Limits
MAX_CONCURRENT_REVIEWS=2
MAX_PATCH_BYTES=100000
MAX_CHANGED_FILES=50
# PR size gate: when estimated review time exceeds the budget, the bot posts
# a PR-split proposal instead of a full review. Estimate = changed lines
# / lines-per-minute rate. The rate self-calibrates from observed review
# durations (median of recent completed jobs); PR_LINES_PER_MINUTE is the
# initial value / fallback until enough samples exist.
PR_SIZE_GATE=true
PR_REVIEW_BUDGET_MINUTES=15
PR_LINES_PER_MINUTE=100
WORKTREE_TTL_HOURS=24
# LRU eviction of registered clones when disk usage exceeds this budget (GB).
# 0 = off — eviction deletes a clone, which unregisters the repo.
WORKSPACE_DISK_BUDGET_GB=0

# Queue: memory or file (BoltDB)
QUEUE_BACKEND=memory
QUEUE_FILE_PATH=/tmp/elyoraa/queue.db

# Bot
BOT_HANDLE=elyoraa

# Timeouts. REVIEW_TIMEOUT bounds the whole job — review attempt(s),
# retry backoffs, and the reconcile second pass — so keep it comfortably
# >= PR_REVIEW_BUDGET_MINUTES or budget-sized PRs are killed mid-review.
REVIEW_TIMEOUT=30m
COMMENT_TIMEOUT=60s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
# Per-attempt timeout for each devin invocation; 0 = use REVIEW_TIMEOUT.
# Set below REVIEW_TIMEOUT to make timeouts retriable.
# DEVIN_ATTEMPT_TIMEOUT=0

# Devin retry policy: retries for transient failures after the first attempt.
# Attempts = 1 + DEVIN_MAX_RETRIES; backoffs are comma-separated durations.
DEVIN_MAX_RETRIES=3
DEVIN_RETRY_BACKOFFS=30s,2m,5m
# Pre-flight check: run `devin models list` before each attempt and require
# the configured model to be present. Disable if your devin build lacks it.
DEVIN_PREFLIGHT_CHECK=true

# Server
PORT=8083
LOG_LEVEL=info
